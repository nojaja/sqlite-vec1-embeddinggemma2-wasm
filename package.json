{
  "name": "@nojaja/sqlite-vec1-embeddinggemma2-wasm",
  "version": "0.0.1",
  "description": "SQLite official vec1 and EmbeddingGemma 2 with WebAssembly runtimes",
  "keywords": ["sqlite", "sqlite-wasm", "vector-search", "embeddings", "typescript"],
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.bundle.js",
  "types": "./dist/index.d.ts",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nojaja/sqlite-vec1-embeddinggemma2-wasm.git"
  },
  "bugs": { "url": "https://github.com/nojaja/sqlite-vec1-embeddinggemma2-wasm/issues" },
  "homepage": "https://github.com/nojaja/sqlite-vec1-embeddinggemma2-wasm#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.mjs",
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.js",
        "default": "./dist/node/index.js"
      },
      "default": "./dist/node/index.js"
    },
    "./browser": { "types": "./dist/index-browser.d.ts", "default": "./dist/browser/index.mjs" },
    "./node": { "types": "./dist/index.d.ts", "import": "./dist/node/index.mjs", "require": "./dist/node/index.js", "default": "./dist/node/index.js" },
    "./sqlite3.wasm": "./dist/sqlite3.wasm",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=24 <25" },
  "files": ["dist", "manifests", "README.md", "LICENSE", "samples"],
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "@swc/core@1.16.21": false,
    "esbuild@0.28.2": false,
    "fsevents@2.3.3": false,
    "lmdb@2.8.5": false,
    "msgpackr-extract@3.0.6": false,
    "onnxruntime-node@1.31.1": false,
    "protobufjs@7.6.6": false,
    "unrs-resolver@1.12.2": false
  },
  "scripts": {
    "build": "node scripts/build/package.ts",
    "build:inference": "node scripts/build/inference.ts",
    "test": "jest --config jest.unit.config.js --runInBand",
    "test:ci": "jest --config jest.unit.config.js --runInBand --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:e2e:directml": "jest --config jest.e2e.config.js --runInBand --runTestsByPath test/e2e/sql-semantic-search-directml.test.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise src tooling scripts --config .dependency-cruiser.js",
    "typedoc": "node node_modules/typedoc/bin/typedoc --options typedoc.js",
    "test:sqlite": "node scripts/run.ts test-official-sqlite",
    "test:storage": "node scripts/run.ts test-storage",
    "test:search": "node scripts/run.ts test-official-model",
    "test:embedding-cache": "node scripts/run.ts test-official-cache && node scripts/run.ts test-official-model",
    "test:sql-bridge": "node scripts/run.ts test-official-timeout && npm run test:e2e -- --runTestsByPath test/e2e/sql-semantic-search.test.ts",
    "test:inference:browser": "node scripts/run.ts test-inference-browser",
    "test:inference:node:directml": "node scripts/run.ts probe-node-directml",
    "test:embedding-quality": "node scripts/run.ts test-embedding-quality",
    "test:sqlite-wasm-compat": "node scripts/run.ts test-sqlite-wasm-compat",
    "test:assets": "node scripts/run.ts test-assets",
    "test:inference": "node scripts/run.ts test-inference",
    "lock:model": "node scripts/assets/lock-model.ts",
    "lock-assets": "node scripts/assets/lock-assets.ts",
    "audit:release": "node scripts/release/audit.ts",
    "package": "npm run build && node scripts/release/package.ts",
    "test:package": "node scripts/release/test-package.ts",
    "walkthrough": "node scripts/walkthrough.ts"
  },
  "devDependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "4.3.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@parcel/config-default": "2.16.4",
    "@parcel/core": "2.16.4",
    "@rsbuild/core": "2.2.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.5",
    "dependency-cruiser": "17.4.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "html-webpack-plugin": "5.6.8",
    "image-size": "2.0.4",
    "jest": "30.5.2",
    "onnxruntime-node": "1.31.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "parcel": "2.16.4",
    "playwright-core": "1.62.0",
    "ts-jest": "29.4.14",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "webpack": "5.112.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "@istanbuljs/load-nyc-config": { "js-yaml": "4.3.2" }
  }
}